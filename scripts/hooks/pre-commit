#!/bin/bash
# Pre-commit hook for vocabulary-anki-automator.
#
# This file is the tracked source of truth; git only reads
# .git/hooks/pre-commit, which is never committed. `scripts/bootstrap-macos.sh`
# installs it by copying this file there and marking it executable. Re-run the
# bootstrap script any time this file changes.
#
# Static checks (Milestone A) plus the fast test tiers (Milestone G): unit +
# integration via scripts/run-all-checks.sh. The E2E tier stays out of here
# (pre-push/nightly) because it builds and launches the app.
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

echo "[pre-commit] cargo fmt --all --check"
cargo fmt --all --check

echo "[pre-commit] cargo clippy --workspace --all-targets -- -D warnings"
cargo clippy --workspace --all-targets -- -D warnings

echo "[pre-commit] vue-tsc --noEmit (Automator, Learn)"
npx vue-tsc --noEmit
npx vue-tsc --noEmit -p apps/learn

echo "[pre-commit] ESLint + Prettier"
npm run lint

echo "[pre-commit] unit + integration tests"
./scripts/run-all-checks.sh

echo "[pre-commit] all checks passed"
