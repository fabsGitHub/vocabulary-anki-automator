{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vocabulary Automator",
  "version": "0.1.0",
  "identifier": "com.ankiautomator.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Vocabulary Automator",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "{{env.APPLE_SIGNING_IDENTITY:::}}",
      "entitlements": "./entitlements.mac.plist",
      "minimumSystemVersion": "10.13"
    },
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "KEYS_PLACEHOLDER_REPLACE_AFTER_GENERATION",
      "endpoints": [
        "https://github.com/fabsGitHub/vocabulary-anki-automator/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
