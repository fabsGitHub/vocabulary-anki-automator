{
  "name": "vocab-automator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test:unit": "vitest run && vitest run --config apps/learn/vitest.config.ts",
    "test:e2e": "echo 'no E2E harness yet (Milestone G wires tauri-driver + WebdriverIO here); see docs/test-harness-strategy.md' && exit 0",
    "learn:dev": "vite --config apps/learn/vite.config.ts",
    "learn:dev:web": "vite --config apps/learn/vite.config.ts --mode web",
    "learn:build": "vue-tsc --noEmit -p apps/learn && vite build --config apps/learn/vite.config.ts",
    "learn:build:web": "vue-tsc --noEmit -p apps/learn && vite build --config apps/learn/vite.config.ts --mode web",
    "learn:tauri": "cd apps/learn && tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-opener": "2.5.4",
    "@tauri-apps/plugin-updater": "2.14.0",
    "vue": "^3.5.13",
    "vue-i18n": "11.4.13"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.3",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/eslint-config-prettier": "^10.1.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.17.0",
    "eslint-plugin-vue": "^9.32.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^2.1.10"
  }
}
